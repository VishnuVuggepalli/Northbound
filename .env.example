# Northbound runtime secrets — copy to `.env` and fill in. NEVER commit `.env`.

# Fernet key — encrypts device credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NB_MASTER_KEY=

# JWT signing secret (HS256). Generate with:
#   openssl rand -hex 32
NB_SECRET_KEY=

# Alternatively, load either secret from a FILE instead of inline (Docker/K8s/
# systemd secrets convention — keeps it off the command line and out of `ps`).
# The inline var above wins if both are set. Example:
#   NB_MASTER_KEY_FILE=/run/secrets/nb_master_key
#   NB_SECRET_KEY_FILE=/run/secrets/nb_secret_key

# Optional: set fixed seed passwords (else a random admin password is printed
# once to the container log on first boot).
NB_SEED_ADMIN_PASSWORD=
NB_SEED_ALICE_PASSWORD=

# --- Scale out (only needed with the Postgres overlay / multi-worker) ---
# See README "Scale out". The base single-worker SQLite setup needs none of these.
#
# Postgres password for docker-compose.postgres.yml (generate: openssl rand -hex 16):
NB_PG_PASSWORD=
# uvicorn worker count (default 1). >1 requires NB_RATELIMIT_STORAGE_URI below.
# NB_WEB_CONCURRENCY=4
# Shared rate-limit store so limits hold across workers (needs the .[redis] extra):
# NB_RATELIMIT_STORAGE_URI=redis://redis:6379/0
