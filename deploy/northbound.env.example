# Northbound production environment file.
# Install to /etc/northbound/env with mode 0600 (root:root or northbound).
# Referenced by deploy/northbound.service via EnvironmentFile=. NEVER commit the
# real file — only this example.

# --- REQUIRED outside development ---
NB_ENVIRONMENT=production

# JWT signing secret. Generate: openssl rand -hex 32
NB_SECRET_KEY=replace-with-a-long-random-secret

# Fernet master key for credential encryption at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NB_MASTER_KEY=replace-with-a-fernet-key

# --- Database (single-file SQLite on the data volume) ---
NB_DB_URL=sqlite+aiosqlite:////var/lib/northbound/northbound.db

# --- Frontend (built SPA served in place) ---
NB_FRONTEND_DIST=/opt/northbound/frontend/dist

# --- Optional: one-time seed passwords (consumed by seed.py, not the server) ---
# NB_SEED_ADMIN_PASSWORD=...
# NB_SEED_ALICE_PASSWORD=...
